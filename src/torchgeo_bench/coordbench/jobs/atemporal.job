#!/bin/bash
#SBATCH --job-name=cb-atemporal
#SBATCH --array=0-8
#SBATCH --mem=32g
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gpu-bind=closest
#SBATCH --account=bgtj-tgirails
#SBATCH --time=8:00:00
#SBATCH --output=slurm_logs/%x_%A_%a.out

set -euo pipefail
export OMP_NUM_THREADS=1

REPO=/u/lbetti/projects/torchgeo-bench
RESULTS=/projects/bgtj/t_satclip/results

source "$REPO/.venv/bin/activate"

MODELS=(
    sincos
    satclip
    geoclip
    mind
    mind-small
    sinr
    climplicit
    gtloc
    "t_satclip/t_satclip_doy_1M"
)
MODEL=${MODELS[$SLURM_ARRAY_TASK_ID]}
echo "Task $SLURM_ARRAY_TASK_ID: model=$MODEL"

torchgeo-bench coord \
    --model "$MODEL" \
    --dataset pdfm air_temp california_housing satclip sustainbench better_together \
              cdc_places usavars country ecoregions worldclim soilgrids deepmind \
    --split both \
    --resume \
    --output "$RESULTS/coordbench_atemporal.csv" \
    --device cuda:0 \
    "$@"
