#!/bin/bash
#SBATCH --job-name=cb-era5
#SBATCH --array=0-15
#SBATCH --mem=20g
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gpu-bind=closest
#SBATCH --account=bgtj-tgirails
#SBATCH --time=4:00:00
#SBATCH --output=slurm_logs/%x_%A_%a.out

set -euo pipefail
export OMP_NUM_THREADS=1

REPO=/u/lbetti/projects/torchgeo-bench
RESULTS=/projects/bgtj/t_satclip/results

source "$REPO/.venv/bin/activate"
export SATCLIP_HOME=/u/lbetti/projects/temporal-satclip
export CKPT_HOME=/projects/bgtj/t_satclip/ckpts

MODELS=(
    climplicit
    gtloc
    "t_satclip/t_satclip_doy_1M"
    "t_satclip/t_satclip_toy_200k"
    "t_satclip/t_satclip_toy_300k"
    "t_satclip/t_satclip_toy_y_100k"
    "t_satclip/t_satclip_toy_y_150k"
    "t_satclip/t_satclip_toy_y_200k"
    "t_satclip/t_satclip_toy_y_200k_satcliploss"
    "t_satclip/t_satclip_toy_y_200k_softloss"
    "t_satclip/t_satclip_toy_y_250k"
    "t_satclip/t_satclip_toy_y_300k"
    "t_satclip/t_satclip_toy_y_300k_satcliploss"
    "t_satclip/t_satclip_toy_y_300k_softloss"
    "t_satclip/t_satclip_y_200k"
    "t_satclip/t_satclip_y_300k"
)
MODEL=${MODELS[$SLURM_ARRAY_TASK_ID]}
echo "Task $SLURM_ARRAY_TASK_ID: model=$MODEL"

torchgeo-bench coord \
    --model "$MODEL" \
    --dataset era5_ecmwf \
    --nested-splits random,random spatial,random temporal_checkerboard,random \
    --time-units week,1 week,2 month,1 quarter,1 \
    --methods linear idw \
    --resume \
    --output "$RESULTS/coordbench_era5_temporal.csv" \
    --device cuda:0 \
    "$@"
