#!/bin/bash
#SBATCH --mem=16g
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1    # <- match to OMP_NUM_THREADS
#SBATCH --partition=gpu_a100      # <- or cpu_amd, gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gpu-bind=closest
#SBATCH --account=bgtj-tgirails
#SBATCH --time=1:00:00      # hh:mm:ss for the job
##SBATCH --mail-user=livia.betti@colorado.edu
##SBATCH --mail-type="BEGIN,END" See sbatch or srun man pages for more email options
#SBATCH --output=slurm_logs/%x_%A_%a.out
#SBATCH --job-name=temp-agg

set -x
export OMP_NUM_THREADS=1

cd /u/lbetti/projects/torchgeo-bench/src/torchgeo_bench/coordbench/scripts
source /u/lbetti/projects/torchgeo-bench/.venv/bin/activate

torchgeo-bench coord --model t_satclip/t_satclip_doy_1M --dataset era5_ecmwf --split both \
    --temporal-discretization-methods 1_week 2_weeks 4_weeks 13_weeks \
    --output "/projects/bgtj/t_satclip/results/coordbench_era5_embedding_aggregation.csv" \
    --device cuda:0 "$@"