#!/bin/bash
#SBATCH --job-name=cb-temporal-test
#SBATCH --array=0-6
#SBATCH --mem=128g
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gpu-bind=closest
#SBATCH --account=bgtj-tgirails
#SBATCH --time=8:00:00
#SBATCH --output=slurm_logs/%x_%A_%a.out

# Smoke test: one array task per dataset runs IDW and one linear model on the full data with a single
# hyperparameter and 2 inner folds, using the same splits and time units as the full runs. Also downloads each dataset.
source "$SLURM_SUBMIT_DIR/_temporal_splits.sh"
setup_env
nvidia-smi --query-gpu=name,memory.total --format=csv

DATASET=${DATASETS[$SLURM_ARRAY_TASK_ID]}
OUT=$RESULTS_ROOT/temporal_splits_test
rm -rf "${OUT:?}/$DATASET"

FAST=(--inner-folds 2 --ridge-alphas 1.0 --idw-ks 5 --idw-cs 1.0)
run_coord "$DATASET" "" "$OUT" "${FAST[@]}" "$@"
run_coord "$DATASET" "t_satclip/t_satclip_doy_1M" "$OUT" "${FAST[@]}" "$@"
