#!/bin/bash
#SBATCH --job-name=cb-usa_electric_load_daily
#SBATCH --mem=32g
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --partition=gpu_a100
#SBATCH --gpus-per-node=1
#SBATCH --gpu-bind=closest
#SBATCH --account=bgtj-tgirails
#SBATCH --time=24:00:00
#SBATCH --output=slurm_logs/%x_%A_%a.out

# Submit with submit_temporal_splits.sh usa_electric_load_daily (IDW as task 0, then one linear task per model).
source "$SLURM_SUBMIT_DIR/_temporal_splits.sh"
run_array_task usa_electric_load_daily "$@"
